# ============================================================
# Date Manager — Environment-Vorlage
#
# Diese Datei dient nur als Referenz, welche Werte gepflegt
# werden muessen. Im Produktiv-Setup werden die Werte als
# **GitHub Actions Secrets** in
#   github.com/joschkarick-homelab/couple-date-guide/settings/secrets/actions
# gepflegt. Die Deploy-Pipeline (.github/workflows/deploy.yml)
# rendert daraus auf dem LXC die `stack.env`.
# ============================================================

# --- Domain & oauth2-proxy ----------------------------------
COOKIE_DOMAIN=date.deine-domain.de
OAUTH_REDIRECT_URL=https://date.deine-domain.de/oauth2/callback
HOST_PORT=4180

# --- Authentik (aus Provider-Detailseite in Authentik) ------
OIDC_ISSUER_URL=https://authentik.deine-domain.de/application/o/couple-date-guide/
OIDC_CLIENT_ID=replace-me-from-authentik
OIDC_CLIENT_SECRET=replace-me-from-authentik

# Cookie-Verschluesselung. Erzeugen: openssl rand -base64 32
COOKIE_SECRET=replace-me-32-bytes-random

# --- App / Auth ---------------------------------------------
ALLOWED_EMAILS=rick@mindsquare.de,deine-frau@example.com

# Bearer-Token fuer iOS-Kurzbefehl. Erzeugen: openssl rand -hex 32
QUICK_ADD_TOKEN=replace-me-long-random-string

# --- AI Provider: Claude ------------------------------------
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-DEIN-KEY-HIER
ANTHROPIC_MODEL=claude-sonnet-4-6

# Andere Provider leer lassen
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Bilder (optional) --------------------------------------
UNSPLASH_ACCESS_KEY=

# --- Push Notifications (optional) --------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rick@mindsquare.de
