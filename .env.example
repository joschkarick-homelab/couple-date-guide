# ====================================================================
# Date Manager – Beispiel-Konfiguration
# Kopiere diese Datei zu .env und passe die Werte an.
# ====================================================================

# --- App ---
APP_ENV=production                   # production | development
DATABASE_PATH=/app/data/datemgr.db   # SQLite-Pfad im Container
LOG_LEVEL=info

# --- Auth (oauth2-proxy davor) ---
# In Production lauscht oauth2-proxy auf 4180 und proxied zur App.
# Die App liest den authentifizierten User aus diesen Headern:
AUTH_HEADER_USER=X-Forwarded-Preferred-Username
AUTH_HEADER_EMAIL=X-Forwarded-Email

# Erlaubte E-Mails (komma-separiert) – nur diese kommen rein.
# Egal wer bei Authentik angemeldet ist, das hier ist die letzte Schranke.
ALLOWED_EMAILS=rick@mindsquare.de,frau@example.com

# Dev-Modus: wenn true, wird ein Fake-User verwendet (kein oauth2-proxy nötig).
# NIEMALS in Produktion auf true setzen.
AUTH_DEV_MODE=false
AUTH_DEV_USER_EMAIL=rick@mindsquare.de

# --- Quick-Add (iOS Kurzbefehl) ---
# Statisches Bearer-Token nur fuer den /api/ideas/quick-add-Endpoint.
# Im Kurzbefehl als Authorization-Header mitgeben.
QUICK_ADD_TOKEN=ersetze-mich-mit-langem-zufallsstring

# --- AI Provider ---
# Welcher Provider wird genutzt: claude | gemini | perplexity | openai
AI_PROVIDER=claude

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Perplexity
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Bilder ---
# Stock-Foto-Suche fuer Date-Ideen
UNSPLASH_ACCESS_KEY=

# --- Notifications (Web Push) ---
# Mit `npx web-push generate-vapid-keys` einmalig erzeugen.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rick@mindsquare.de

# --- Frontend Build ---
VITE_API_URL=/api
